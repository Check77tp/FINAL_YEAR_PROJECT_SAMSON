PORT=5000
NODE_ENV=development

# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) keys - generate with: npx web-push generate-vapid-keys
# Leave empty to disable push notifications (the rest of the app still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: AI triage suggestions (Claude). Without a key the app uses keyword rules instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
